wilson[k_, n_] := With[{p = k/n, z = 1.96}, {(p + z^2/(2 n) - z Sqrt[p (1 - p)/n + z^2/(4 n^2)])/(1 + z^2/n), (p + z^2/(2 n) + z Sqrt[p (1 - p)/n + z^2/(4 n^2)])/(1 + z^2/n)}];
summ[sel_, label_] := If[Length[sel] > 0, With[{k = Total[sel[[All, 7]]], k2 = Total[sel[[All, 8]]], n = Length[sel], z = Abs[sel[[All, 6]]]/(sel[[All, 5]]/2)},
  Print["   ", label, ": n ", n, ", hit ", k, " (", f[100 k/n, 0], "%, 95% [", f[100 wilson[k, n][[1]], 0], ", ", f[100 wilson[k, n][[2]], 0], "]); second scores ", k2,
