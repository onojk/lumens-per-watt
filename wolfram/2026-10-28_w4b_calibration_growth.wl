Print["\nReading: a range used as a ~90% interval should hit ~90% with median z ~0.4-0.5. Hit rate well below 90% with median z > 1 = over-confident (too narrow);"];
Print["hit rate near 100% with median z << 0.5 = under-confident (too wide). Rows within one run share numbers and anchors, so they are not independent;"];
Print["the Wilson intervals treat them as independent and are too narrow."];
Print["\nMisses by row (forecaster | id | quantity | width | err):"];
Do[If[r[[7]] == 0, Print["   ", r[[1]], " | ", r[[2]], " | width ", f[r[[5]], 2], " | err ", f[r[[6]], 2], If[r[[9]] == 1, " (info only)", ""]]], {r, rows}];
Print["\n== W4b additions: the growth round alone"];
Do[With[{c = Select[conf, #[[1]] == who && StringMatchQ[#[[2]], ("R-" | "D-" | "G-") ~~ ("29" | "30" | "31" | "32" | "33" | "22" | "23" | "24" | "25" | "26") ~~ __] &]},
  Print["   ", who, ": ", Length[c], " rows, mean stated ", f[100 Mean[c[[All, 3]]], 1], "%, hit ", Total[c[[All, 4]]], ", Brier ", f[Mean[(c[[All, 3]] - c[[All, 4]])^2], 3]]], {who, {"reviewer", "DeepSeek", "Grok"}}];
Print["   All stated-confidence rows, pooled: ", Length[conf], " rows, ", Total[conf[[All, 4]]], " hit; Wilson 95% on the pooled hit rate ",
  With[{w = wilson[Total[conf[[All, 4]]], Length[conf]]}, "[" <> f[100 w[[1]], 0] <> "%, " <> f[100 w[[2]], 0] <> "%]"]];
