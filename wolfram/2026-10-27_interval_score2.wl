sc[r_] := (r[[7]] - r[[6]]) + (2/alpha) Max[r[[6]] - r[[8]], 0] + (2/alpha) Max[r[[8]] - r[[7]], 0];
cov[r_] := Boole[r[[6]] <= r[[8]] <= r[[7]]];
