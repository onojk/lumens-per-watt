rankReport[sel_, label_] := Module[{rk = Flatten[ranks /@ qs[sel], 1]},
  Print["  ", label, " (", Length[qs[sel]], " questions): mean rank ", StringRiffle[Table[w <> " " <> f[Mean[Select[rk, #[[1]] == w &][[All, 2]]], 2], {w, who}], ", "],
   "; best on ", StringRiffle[Table[w <> " " <> f[best[sel, w], 1], {w, who}], ", "], " questions (ties split)"]];
best[sel_, w_] := Total[Table[With[{m = Min[sc /@ g]}, If[MemberQ[Select[g, sc[#] == m &][[All, 1]], w], 1/Count[sc /@ g, m], 0]], {g, qs[sel]}]];
Print["\n== Ranking on (b) only: mean rank of each forecaster's interval score per common question (1 = best, 3 = worst; unit-free)"];
Do[rankReport[Select[rows, #[[10]] && ! #[[9]] && #[[5]] == t &], t], {t, types}];
rankReport[Select[rows, #[[10]] && ! #[[9]] &], "all types"];
Print["\nPer common question (scores reviewer / DeepSeek / Grok):"];
Do[With[{g = SortBy[q, Position[who, #[[1]]][[1, 1]] &]}, Print["  ", g[[1, 3]], " [", g[[1, 5]], If[g[[1, 9]], ", info only", ""], "]: ", StringRiffle[f[sc[#], 1] & /@ g, " / "]]], {q, qs[Select[rows, #[[10]] &]]}];
